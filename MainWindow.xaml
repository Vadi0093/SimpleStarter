<Window
    x:Class="SimpleStarter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimpleStarter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SimpleStarter"
    Width="36"
    Height="80"
    AllowsTransparency="True"
    Background="#26262A"
    Foreground="White"
    MouseLeftButtonUp="OpenSecondWindow"
    Opacity="0.8"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock
            x:Name="Icon"
            FontSize="20"
            Text="❮" />
    </StackPanel>
</Window>